<Window x:Class="Tenefus_hesaplayan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teneffüs Hesaplayan"
        Height="640" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        ResizeMode="CanResize"
        MouseDown="Window_MouseDown"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#181825"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#313244"/>
        <SolidColorBrush x:Key="TextBrush" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#A6ADC8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#89B4FA"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#181825"/>
        <SolidColorBrush x:Key="TimeBrush" Color="#F38BA8"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#F9E2AF"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#F38BA8"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#A6E3A1"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#313244"/>

        <SolidColorBrush x:Key="ButtonBgBrush" Color="#313244"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#45475A"/>
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#585B70"/>
        <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>

        <LinearGradientBrush x:Key="IslandBgBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A1B26" Offset="0.0"/>
            <GradientStop Color="#0E0F16" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IslandBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4A5170" Offset="0.0"/>
            <GradientStop Color="#24283B" Offset="1.0"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="IslandTextBrush" Color="#C0CAF5"/>
        <SolidColorBrush x:Key="IslandSeparatorBrush" Color="#2F3349"/>
        <SolidColorBrush x:Key="IslandProgressBgBrush" Color="#26FFFFFF"/>

        <!-- ============ YAPRAK SAAT TEMASI (varsayılan: karanlık) ============ -->
        <SolidColorBrush x:Key="LeafContainerBgBrush" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="LeafContainerBorderBrush" Color="#242424"/>
        <SolidColorBrush x:Key="LeafCardTopBrush" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="LeafCardBottomBrush" Color="#161616"/>
        <SolidColorBrush x:Key="LeafCardBorderBrush" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="LeafDigitBrush" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="LeafCardDividerBrush" Color="#000000"/>
        <SolidColorBrush x:Key="LeafSeparatorDotBrush" Color="#5A5A5A"/>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource SubTextBrush}"
                                                        CornerRadius="3" Opacity="0.45"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{DynamicResource WarnBrush}"/>
            <Setter Property="Foreground" Value="#181825"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="12" Padding="4"
                                    HorizontalAlignment="Center">
                                <TabPanel IsItemsHost="True" Panel.ZIndex="1"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="0,16,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="Transparent"
                                CornerRadius="9" Margin="2,0" Padding="20,8">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScheduleColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrushColor}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScheduleRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="rowBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="2,2" SnapsToDevicePixels="True">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rowBorder" Property="Background"
                                        Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="rowBorder" Property="Background"
                                        Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScheduleCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="CellTimeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
        </Style>

        <Style x:Key="CellEditStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="WindowFrame"
                CornerRadius="18"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="7" Opacity="0.55"/>
            </Border.Effect>
        </Border>

        <Grid>

            <!-- ============ ANA ARAYÜZ ============ -->
            <Grid x:Name="MainUIGrid" Margin="22,18,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="11"
                                Background="{DynamicResource SurfaceBrush}">
                            <TextBlock Text="🏫" FontSize="19"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Teneffüs Hesaplayan"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Ders &amp; Teneffüs Takibi"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       FontSize="11" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="btnSettings" Content="⚙" Width="38" Height="38"
                                FontSize="15" Padding="0" Margin="0,0,8,0"
                                Click="BtnSettings_Click"/>
                        <Button Content="✕" Width="38" Height="38" FontSize="13"
                                Padding="0" Click="BtnCloseApp_Click"/>
                    </StackPanel>
                </Grid>

                <TabControl Grid.Row="1">
                    <TabItem Header="⏱  Sayaç">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                            <TextBlock x:Name="txtStatus" Text="Yükleniyor..."
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="19" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtStatusSub" Text=""
                                       Foreground="{DynamicResource SubTextBrush}"
                                       FontSize="12" HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>

                            <Grid Width="210" Height="210" HorizontalAlignment="Center"
                                  Margin="0,16,0,16">
                                <Ellipse Width="190" Height="190"
                                         Stroke="{DynamicResource BorderBrushColor}"
                                         StrokeThickness="10" Opacity="0.55"/>
                                <Ellipse x:Name="ringProgress" Width="190" Height="190"
                                         Stroke="{DynamicResource AccentBrush}"
                                         StrokeThickness="10"
                                         StrokeDashArray="0.001 59.69"
                                         StrokeDashCap="Round"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtCountdown" Text="00:00"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="46" FontWeight="Bold"
                                               FontFamily="Consolas" HorizontalAlignment="Center"/>
                                    <TextBlock Text="KALAN SÜRE"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrushColor}"
                                    BorderThickness="1"
                                    CornerRadius="13" Padding="14,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="30" Height="30"
                                            CornerRadius="9"
                                            Background="{DynamicResource SurfaceBrush}">
                                        <TextBlock Text="⏭" FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="SIRADAKİ"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   FontSize="9" FontWeight="Bold"/>
                                        <TextBlock x:Name="txtNext" Text="—"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,16,0,0">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource TimeBrush}"
                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="txtCurrentTime" Text="00:00:00"
                                           Foreground="{DynamicResource TimeBrush}"
                                           FontSize="14" FontWeight="Bold"
                                           FontFamily="Consolas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="📅  Ders Programı">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrushColor}"
                                    BorderThickness="1"
                                    CornerRadius="14" Padding="4">
                                <DataGrid x:Name="ScheduleListView"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{DynamicResource TextBrush}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          CanUserReorderColumns="False"
                                          CanUserSortColumns="False"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          RowHeight="42"
                                          ColumnHeaderHeight="38"
                                          GridLinesVisibility="None"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ColumnHeaderStyle="{StaticResource ScheduleColumnHeaderStyle}"
                                          RowStyle="{StaticResource ScheduleRowStyle}"
                                          CellStyle="{StaticResource ScheduleCellStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ETKİNLİK" Binding="{Binding Name}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource CellEditStyle}"/>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="BAŞLANGIÇ" Binding="{Binding StartString}" Width="92">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTimeTextStyle}"/>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource CellEditStyle}"/>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="BİTİŞ" Binding="{Binding EndString}" Width="92">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTimeTextStyle}"/>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource CellEditStyle}"/>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <UniformGrid Grid.Row="1" Rows="1" Margin="0,14,0,0">
                                <Button Content="➕  Ekle" Click="BtnAdd_Click" Height="38"
                                        Margin="4,0" Style="{StaticResource AccentButton}"/>
                                <Button Content="🗑  Sil" Click="BtnDelete_Click" Height="38" Margin="4,0"/>
                                <Button Content="🔄  Sıfırla" Click="BtnReset_Click" Height="38" Margin="4,0"/>
                                <Button Content="💾  Kaydet" Click="BtnSave_Click" Height="38" Margin="4,0"/>
                            </UniformGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ============ AYARLAR PANELİ ============ -->
            <Border x:Name="SettingsOverlayPanel"
                    Visibility="Collapsed"
                    Background="#A6000000"
                    CornerRadius="18"
                    Panel.ZIndex="100">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border Width="290"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrushColor}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,62,18,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="22"
                                          ShadowDepth="6" Opacity="0.5"/>
                    </Border.Effect>

                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="AYARLAR"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="Görünüm ve pencere modu"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           FontSize="10" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Content="✕" Width="26" Height="26" FontSize="10"
                                    Padding="0" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Click="CloseSettings_Click"/>
                        </Grid>

                        <Button x:Name="btnTheme" Content="🌙   Karanlık Mod"
                                Click="BtnTheme_Click" Height="42"
                                HorizontalContentAlignment="Left"
                                Padding="14,0" Margin="0,0,0,8"/>

                        <Button x:Name="btnDynamicIsland" Content="🏝   Dinamik Ada"
                                Click="BtnDynamicIsland_Click" Height="42"
                                HorizontalContentAlignment="Left"
                                Padding="14,0"/>

                        <Button x:Name="btnLeafClock" Content="🍃   Yaprak Saat"
                                Click="BtnLeafClock_Click" Height="42"
                                HorizontalContentAlignment="Left"
                                Padding="14,0" Margin="0,8,0,0"/>

                        <Button x:Name="btnStartup" Content="🚀   Başlangıçta Aç: Kapalı"
                                Click="BtnStartup_Click" Height="42"
                                HorizontalContentAlignment="Left"
                                Padding="14,0" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ============ DİNAMİK ADA ============ -->
            <Border x:Name="DynamicIslandBorder"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    Background="Transparent"
                    Panel.ZIndex="200"
                    MouseLeftButtonDown="DynamicIsland_MouseLeftButtonDown">
                <Viewbox x:Name="IslandViewbox" Stretch="Uniform" Width="260" Height="42">
                    <Border Width="260" Height="42"
                            CornerRadius="0,0,21,21"
                            Cursor="Hand"
                            Background="{DynamicResource IslandBgBrush}"
                            BorderBrush="{DynamicResource IslandBorderBrush}"
                            BorderThickness="0,0,1.2,1.2">
                        <Grid>
                            <Grid Margin="14,0,14,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Ellipse x:Name="islandDot" Width="6" Height="6"
                                             Fill="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"/>
                                    <TextBlock x:Name="txtIslandStatus" Text="Dersteyiz"
                                               Foreground="{DynamicResource IslandTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="100"/>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Width="1" Height="14"
                                           Fill="{DynamicResource IslandSeparatorBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2" x:Name="txtIslandTime" Text="00:00"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="19" FontWeight="Bold"
                                           FontFamily="Consolas" VerticalAlignment="Center"/>
                            </Grid>

                            <ProgressBar x:Name="prgIsland" Height="3" Minimum="0" Maximum="100"
                                         Value="0" VerticalAlignment="Bottom"
                                         Margin="26,0,26,5"
                                         Background="{DynamicResource IslandProgressBgBrush}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         BorderThickness="0" IsHitTestVisible="False">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                            <Border x:Name="PART_Track"/>
                                            <Border x:Name="PART_Indicator"
                                                    Background="{TemplateBinding Foreground}"
                                                    CornerRadius="2" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                        </Grid>
                    </Border>
                </Viewbox>
            </Border>

            <!-- ============ YAPRAK SAAT / FLIP CLOCK (tema uyumlu) ============ -->
            <Border x:Name="LeafClockBorder"
                    Visibility="Collapsed"
                    Panel.ZIndex="250"
                    Cursor="SizeAll"
                    RenderTransformOrigin="0.5,0.5"
                    MouseEnter="LeafClock_MouseEnter"
                    MouseLeave="LeafClock_MouseLeave"
                    PreviewMouseLeftButtonDown="LeafClock_MouseDown"
                    PreviewMouseMove="LeafClock_MouseMove"
                    PreviewMouseLeftButtonUp="LeafClock_MouseUp">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="leafHoverScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>

                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30"
                                      ShadowDepth="8" Opacity="0.7"/>
                </Border.Effect>

                <Border Background="{DynamicResource LeafContainerBgBrush}"
                        CornerRadius="16"
                        BorderBrush="{DynamicResource LeafContainerBorderBrush}"
                        BorderThickness="1"
                        Padding="14,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <Grid Width="56" Height="82" Margin="0,0,3,0">
                            <Border CornerRadius="8,8,0,0"
                                    Background="{DynamicResource LeafCardTopBrush}"
                                    VerticalAlignment="Top" Height="41"/>
                            <Border CornerRadius="0,0,8,8"
                                    Background="{DynamicResource LeafCardBottomBrush}"
                                    VerticalAlignment="Bottom" Height="41"/>
                            <Border CornerRadius="8"
                                    BorderBrush="{DynamicResource LeafCardBorderBrush}"
                                    BorderThickness="1" Background="Transparent"/>
                            <TextBlock x:Name="txtLeafH1" Text="0"
                                       FontFamily="Consolas" FontSize="54" FontWeight="Bold"
                                       Foreground="{DynamicResource LeafDigitBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-3,0,0" RenderTransformOrigin="0.5,0.5"/>
                            <Rectangle Height="2"
                                       Fill="{DynamicResource LeafCardDividerBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Width="56" Height="82" Margin="0,0,8,0">
                            <Border CornerRadius="8,8,0,0"
                                    Background="{DynamicResource LeafCardTopBrush}"
                                    VerticalAlignment="Top" Height="41"/>
                            <Border CornerRadius="0,0,8,8"
                                    Background="{DynamicResource LeafCardBottomBrush}"
                                    VerticalAlignment="Bottom" Height="41"/>
                            <Border CornerRadius="8"
                                    BorderBrush="{DynamicResource LeafCardBorderBrush}"
                                    BorderThickness="1" Background="Transparent"/>
                            <TextBlock x:Name="txtLeafH2" Text="0"
                                       FontFamily="Consolas" FontSize="54" FontWeight="Bold"
                                       Foreground="{DynamicResource LeafDigitBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-3,0,0" RenderTransformOrigin="0.5,0.5"/>
                            <Rectangle Height="2"
                                       Fill="{DynamicResource LeafCardDividerBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource LeafSeparatorDotBrush}"
                                     Margin="0,0,0,10"/>
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource LeafSeparatorDotBrush}"/>
                        </StackPanel>

                        <Grid Width="56" Height="82" Margin="0,0,3,0">
                            <Border CornerRadius="8,8,0,0"
                                    Background="{DynamicResource LeafCardTopBrush}"
                                    VerticalAlignment="Top" Height="41"/>
                            <Border CornerRadius="0,0,8,8"
                                    Background="{DynamicResource LeafCardBottomBrush}"
                                    VerticalAlignment="Bottom" Height="41"/>
                            <Border CornerRadius="8"
                                    BorderBrush="{DynamicResource LeafCardBorderBrush}"
                                    BorderThickness="1" Background="Transparent"/>
                            <TextBlock x:Name="txtLeafM1" Text="0"
                                       FontFamily="Consolas" FontSize="54" FontWeight="Bold"
                                       Foreground="{DynamicResource LeafDigitBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-3,0,0" RenderTransformOrigin="0.5,0.5"/>
                            <Rectangle Height="2"
                                       Fill="{DynamicResource LeafCardDividerBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Width="56" Height="82">
                            <Border CornerRadius="8,8,0,0"
                                    Background="{DynamicResource LeafCardTopBrush}"
                                    VerticalAlignment="Top" Height="41"/>
                            <Border CornerRadius="0,0,8,8"
                                    Background="{DynamicResource LeafCardBottomBrush}"
                                    VerticalAlignment="Bottom" Height="41"/>
                            <Border CornerRadius="8"
                                    BorderBrush="{DynamicResource LeafCardBorderBrush}"
                                    BorderThickness="1" Background="Transparent"/>
                            <TextBlock x:Name="txtLeafM2" Text="0"
                                       FontFamily="Consolas" FontSize="54" FontWeight="Bold"
                                       Foreground="{DynamicResource LeafDigitBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-3,0,0" RenderTransformOrigin="0.5,0.5"/>
                            <Rectangle Height="2"
                                       Fill="{DynamicResource LeafCardDividerBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ============ TOAST ============ -->
            <Border x:Name="ToastPanel"
                    Visibility="Collapsed"
                    Opacity="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,24"
                    Width="330"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource SuccessBrush}"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Padding="16,13"
                    Panel.ZIndex="300"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.6"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="toastTransform" Y="20"/>
                </Border.RenderTransform>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="toastIconBorder"
                            Grid.Column="0"
                            Width="38" Height="38"
                            CornerRadius="11"
                            Background="{DynamicResource SuccessBrush}"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="toastIcon" Text="✓"
                                   FontSize="19" FontWeight="Bold"
                                   Foreground="#181825"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="toastTitle" Text="Kaydedildi"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="14" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="toastMessage" Text=""
                                   Foreground="{DynamicResource SubTextBrush}"
                                   FontSize="11" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                    </StackPanel>

                    <Rectangle Grid.Column="2" Width="3" Height="26"
                               RadiusX="1.5" RadiusY="1.5"
                               Fill="{DynamicResource SuccessBrush}"
                               VerticalAlignment="Center" Opacity="0.75"/>
                </Grid>
            </Border>

            <!-- ============ ÇIKIŞ ONAY PANELİ ============ -->
            <Border x:Name="ExitConfirmPanel"
                    Visibility="Collapsed"
                    Background="#B3000000"
                    CornerRadius="18"
                    Panel.ZIndex="400">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border Width="330"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrushColor}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="24,22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="32"
                                          ShadowDepth="10" Opacity="0.65"/>
                    </Border.Effect>

                    <StackPanel>
                        <Border Width="58" Height="58" CornerRadius="17"
                                Background="{DynamicResource DangerBrush}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="⚠" FontSize="27" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Programdan Çık?"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>

                        <TextBlock Text="Ders programınız otomatik olarak kaydedilecek. Yine de çıkmak istiyor musunuz?"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   FontSize="12" TextAlignment="Center"
                                   TextWrapping="Wrap" HorizontalAlignment="Center"
                                   Margin="0,8,0,0" LineHeight="17"/>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Vazgeç"
                                    Click="ExitConfirm_No_Click" Height="42"/>
                            <Button Grid.Column="2" Content="Evet, Çık"
                                    Click="ExitConfirm_Yes_Click" Height="42"
                                    Style="{StaticResource DangerButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ============ YÖNETİCİ İZNİ PANELİ ============ -->
            <Border x:Name="AdminConfirmPanel"
                    Visibility="Collapsed"
                    Background="#B3000000"
                    CornerRadius="18"
                    Panel.ZIndex="450">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border Width="340"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrushColor}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="24,22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="34"
                                          ShadowDepth="10" Opacity="0.7"/>
                    </Border.Effect>

                    <StackPanel>
                        <Border Width="62" Height="62" CornerRadius="19"
                                Background="{DynamicResource WarnBrush}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="🛡" FontSize="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Yönetici İzni Gerekli"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>

                        <TextBlock Text="Ders programı kaydedilemedi. Uygulamanın bulunduğu klasöre yazma izni yok."
                                   Foreground="{DynamicResource SubTextBrush}"
                                   FontSize="12" TextAlignment="Center"
                                   TextWrapping="Wrap" HorizontalAlignment="Center"
                                   Margin="0,8,0,0" LineHeight="17"/>

                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="10" Padding="12,9" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Top" Margin="0,1,8,0"/>
                                <TextBlock Text="Onay verirseniz Windows size bir izin penceresi gösterecek ve program yönetici olarak yeniden başlatılacak."
                                           Foreground="{DynamicResource SubTextBrush}"
                                           FontSize="11" TextWrapping="Wrap"
                                           LineHeight="15" MaxWidth="250"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Vazgeç"
                                    Click="AdminConfirm_No_Click" Height="42" Width="100"/>
                            <Button Grid.Column="1"
                                    Content="🛡  Yönetici Olarak Yeniden Başlat"
                                    Click="AdminConfirm_Yes_Click" Height="42"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource WarnButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>